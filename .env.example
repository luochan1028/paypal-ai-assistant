# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# Mock mode works with all values below left empty.

# mock = offline demo (no network, no credentials)
# sandbox = real PayPal sandbox calls (needs CLIENT_ID + CLIENT_SECRET)
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Base URL used for PayPal return/cancel URLs (local demo default).
PAYPAL_BASE_URL=http://localhost:5000

# AI provider: demo = rule-based brain, no key needed.
# Set to an OpenAI-compatible provider + key + model to use a real model.
AI_PROVIDER=demo
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
